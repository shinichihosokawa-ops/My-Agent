{
  "name": "membership-fee-system",
  "version": "3.0.0",
  "description": "会費徴収・照合・領収書自動発行システム（スクリーンショット解析方式）",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "auth": "npx ts-node src/auth.ts",
    "process": "npx ts-node src/index.ts --once",
    "deploy": "gcloud functions deploy membership-fee-process --runtime nodejs20 --trigger-http --allow-unauthenticated --entry-point processScreenshots --source=. --region=asia-northeast1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shinichihosokawa-ops/My-Agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google-cloud/functions-framework": "^5.0.2",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "nodemailer": "^8.0.4",
    "fontkit": "^1.9.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^6.0.2"
  }
}
