{
  "name": "membership-fee-system",
  "version": "2.0.0",
  "description": "会費徴収・照合・領収書自動発行システム（GMOあおぞらネット銀行 + Google Cloud Functions）",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npx functions-framework --target=webhookHandler --port=8080",
    "dev": "npx functions-framework --target=webhookHandler --port=8080 --source=dist",
    "auth": "npx ts-node src/auth.ts",
    "deploy": "gcloud functions deploy membership-fee-webhook --runtime nodejs20 --trigger-http --allow-unauthenticated --entry-point webhookHandler --source=. --region=asia-northeast1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shinichihosokawa-ops/My-Agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "nodemailer": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "typescript": "^6.0.2"
  }
}
