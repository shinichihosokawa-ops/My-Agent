# ===== Google API認証情報 =====
# Google Cloud Consoleで OAuth 2.0 クライアントIDを作成
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=your_refresh_token

# ===== Google Sheets =====
# フォーム回答が蓄積されるスプレッドシートのID
SPREADSHEET_ID=1LyVpFEpDa_gfBJpujC2h6kEkokhb_jaPkwDKC9TCzX4

# ===== GMOあおぞらネット銀行 API =====
# API利用申請後に発行される認証情報
GMO_CLIENT_ID=your_gmo_client_id
GMO_CLIENT_SECRET=your_gmo_client_secret
# Webhook署名検証用シークレット（HS256）
GMO_WEBHOOK_SECRET=your_webhook_secret

